#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

MANAGER=/usr/libexec/terminal-limit-manager

start_service() {
	procd_open_instance
	procd_set_param command "$MANAGER" daemon
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	"$MANAGER" stop >/dev/null 2>&1 || true
}

reload_service() {
	"$MANAGER" apply >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_reload_trigger terminal_limit network firewall
}

