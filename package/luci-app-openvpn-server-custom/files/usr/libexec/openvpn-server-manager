#!/bin/sh

set -eu

ACTION="${1-}"
CLIENT_NAME="${2-}"
EASYRSA_DIR='/etc/easy-rsa'
PKI_DIR="$EASYRSA_DIR/pki"
OPENVPN_DIR='/etc/openvpn/server'
OPENVPN_SECTION='custom_server'

export EASYRSA="$EASYRSA_DIR"
export EASYRSA_PKI="$PKI_DIR"
export EASYRSA_VARS_FILE="$EASYRSA_DIR/vars"
export EASYRSA_BATCH=1

umask 077

OPENVPN_CONFIG="$OPENVPN_DIR/custom_server.conf"
ACCOUNT_DB='/etc/openvpn/server-accounts'
AUTH_SCRIPT='/usr/libexec/openvpn-server-auth'
CLIENT_CHECK_SCRIPT='/usr/libexec/openvpn-server-client-check'

fail() {
	printf '错误：%s\n' "$*" >&2
	exit 1
}

DATA_CIPHERS='CHACHA20-POLY1305
AES-128-GCM
AES-256-GCM
AES-128-CBC
AES-192-CBC
AES-256-CBC
AES-128-OFB
AES-192-OFB
AES-256-OFB
AES-128-CFB
AES-192-CFB
AES-256-CFB
AES-128-CFB1
AES-192-CFB1
AES-256-CFB1
AES-128-CFB8
AES-192-CFB8
AES-256-CFB8
DES-CFB
DES-CBC
RC2-CBC
RC2-CFB
RC2-OFB
DES-EDE-CBC
DES-EDE3-CBC
DES-OFB
DES-EDE-CFB
DES-EDE3-CFB
DES-EDE-OFB
DES-EDE3-OFB
DESX-CBC
RC2-40-CBC
CAST5-CBC
CAST5-CFB
CAST5-OFB
RC2-64-CBC
DES-CFB1
DES-CFB8
DES-EDE3-CFB1
DES-EDE3-CFB8
SEED-CBC
SEED-OFB
SEED-CFB'

supported_data_cipher() {
	list_data_ciphers | grep -Fxq "$1"
}

list_data_ciphers() {
	local supported cipher
	command -v openvpn >/dev/null 2>&1 || return 1
	supported="$(openvpn --show-ciphers 2>/dev/null | awk 'NF { print $1 }')"
	for cipher in $DATA_CIPHERS; do
		printf '%s\n' "$supported" | grep -Fxq "$cipher" && printf '%s\n' "$cipher"
	done
	return 0
}

recommended_data_cipher() {
	local preferred fallback

	if grep -Eiq '(^|[[:space:]])aes([[:space:]]|$)' /proc/cpuinfo; then
		preferred='AES-128-GCM'
		fallback='CHACHA20-POLY1305'
	else
		preferred='CHACHA20-POLY1305'
		fallback='AES-128-GCM'
	fi

	if supported_data_cipher "$preferred"; then
		printf '%s\n' "$preferred"
	elif supported_data_cipher "$fallback"; then
		printf '%s\n' "$fallback"
	else
		fail '当前 OpenVPN 不支持推荐的 AEAD 加密算法。'
	fi
}

configured_data_cipher() {
	local data_cipher
	data_cipher="$(uci -q get openvpn_server.main.data_cipher || true)"
	[ -n "$data_cipher" ] || return 1
	list_data_ciphers | grep -Fxq "$data_cipher" ||
		fail '所选加密算法不可用或不允许使用。'
	printf '%s\n' "$data_cipher"
}

set_openvpn_default() {
	local option="$1"
	local value="$2"
	uci -q get "openvpn.$OPENVPN_SECTION.$option" >/dev/null 2>&1 ||
		uci -q set "openvpn.$OPENVPN_SECTION.$option=$value"
}

replace_managed_push() {
	local marker="$1"
	local value="$2"
	local previous

	previous="$(uci -q get "openvpn_server.main.$marker" || true)"
	[ -z "$previous" ] ||
		uci -q del_list "openvpn.$OPENVPN_SECTION.push=$previous" >/dev/null 2>&1 || true
	uci -q del_list "openvpn.$OPENVPN_SECTION.push=$value" >/dev/null 2>&1 || true
	uci -q add_list "openvpn.$OPENVPN_SECTION.push=$value"
	uci -q set "openvpn_server.main.$marker=$value"
}

remove_managed_push() {
    local marker="$1"
    local previous

    previous="$(uci -q get "openvpn_server.main.$marker" || true)"
    [ -z "$previous" ] ||
        uci -q del_list "openvpn.$OPENVPN_SECTION.push=$previous" >/dev/null 2>&1 || true
    uci -q delete "openvpn_server.main.$marker"
}
valid_client_name() {
	case "$1" in
		''|*[!A-Za-z0-9_-]*|?????????????????????????????????*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_ipv4() {
	printf '%s\n' "$1" | awk -F. '
		NF != 4 { exit 1 }
		{
			for (i = 1; i <= 4; i++) {
				if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
			}
		}
	'
}

valid_uint() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_remote_host() {
	case "$1" in
		''|*[!A-Za-z0-9._:-]*) return 1 ;;
		*) return 0 ;;
	esac
}
valid_remote_interface() {
	case "$1" in
		lan|vpn0|wan|wan6|wg0) return 0 ;;
		*) return 1 ;;
	esac
}

interface_address() {
	local interface="$1" field address
	valid_remote_interface "$interface" || return 1
	if [ "$interface" = 'wan6' ]; then
		field='ipv6-address'
	else
		field='ipv4-address'
	fi
	address="$(ubus call "network.interface.$interface" status 2>/dev/null |
		jsonfilter -e "@['$field'][0].address" 2>/dev/null || true)"
	[ -n "$address" ] || return 1
	printf '%s\n' "$address"
}

valid_cidr() {
    local route network prefix
    route="$1"
    case "$route" in
        */*)
            network="${route%%/*}"
            prefix="${route#*/}"
            valid_ipv4 "$network" || return 1
            valid_uint "$prefix" && [ "$prefix" -le 32 ] || return 1
            ;;
        *) return 1 ;;
    esac
}

prefix_to_netmask() {
    awk -v prefix="$1" 'BEGIN {
        value = prefix
        for (i = 1; i <= 4; i++) {
            if (value >= 8) { octet = 255; value -= 8 }
            else if (value > 0) { octet = 256 - (2 ^ (8 - value)); value = 0 }
            else octet = 0
            printf "%s%s", (i == 1 ? "" : "."), octet
        }
        printf "\n"
    }'
}

valid_auth_mode() {
    case "$1" in account|cert|both) return 0 ;; *) return 1 ;; esac
}

valid_tunnel_type() {
    case "$1" in tun|tap) return 0 ;; *) return 1 ;; esac
}

valid_boolean() {
    case "$1" in 0|1) return 0 ;; *) return 1 ;; esac
}

valid_account_username() {
    case "$1" in
        ''|*[!A-Za-z0-9_.-]*|?????????????????????????????????*) return 1 ;;
        *) return 0 ;;
    esac
}

password_hash() {
    printf '%s' "$1:$2" | sha256sum | awk '{ print $1 }'
}

random_salt() {
    od -An -N16 -tx1 /dev/urandom | tr -d ' \n'
}

validate_extra_config() {
    local extra="$1"
    [ -z "$extra" ] && return 0
    printf '%s\n' "$extra" | awk '
        {
            line = $0
            sub(/^[[:space:]]+/, "", line)
            if (line == "" || line ~ /^[#;]/) next
            if (line ~ /^</ || line ~ /^>/) { print "inline block"; exit 1 }
            split(line, field, /[[:space:]]+/)
            key = tolower(field[1])
            sub(/^--/, "", key)
            if (key ~ /^(config|management|plugin|script-security|auth-user-pass-verify|client-connect|client-disconnect|tls-verify|up|down|route-up|ipchange|learn-address|dev|dev-type|proto|port|server|server-bridge|ca|cert|key|dh|crl-verify|user|group|tls-auth|tls-crypt|secret)$/) {
                print key
                exit 1
            }
        }
    '
}

list_configured_routes() {
    uci -q show openvpn_server.main.push_route 2>/dev/null |
        sed -n "s/^openvpn_server\\.main\\.push_route='\\(.*\\)'$/\\1/p"
}

find_account_section() {
    local wanted="$1" section username
    ACCOUNT_SECTION=''
    for section in $(uci -q show openvpn_server 2>/dev/null |
        sed -n 's/^openvpn_server\.\([^.=]*\)\.username=.*/\1/p'); do
        username="$(uci -q get "openvpn_server.$section.username" || true)"
        if [ "$username" = "$wanted" ]; then
            ACCOUNT_SECTION="$section"
            return 0
        fi
    done
    return 1
}

sync_accounts() {
    local temp section username salt hash
    mkdir -p /etc/openvpn
    temp="$(mktemp /etc/openvpn/server-accounts.XXXXXX)"
    chmod 0600 "$temp"
    for section in $(uci -q show openvpn_server 2>/dev/null |
        sed -n 's/^openvpn_server\.\([^.=]*\)\.username=.*/\1/p'); do
        username="$(uci -q get "openvpn_server.$section.username" || true)"
        salt="$(uci -q get "openvpn_server.$section.salt" || true)"
        hash="$(uci -q get "openvpn_server.$section.password_hash" || true)"
        valid_account_username "$username" || continue
        [ -n "$salt" ] && [ -n "$hash" ] || continue
        printf '%s:%s:%s\n' "$username" "$salt" "$hash" >> "$temp"
    done
    chmod 0640 "$temp"
    chown root:nogroup "$temp" 2>/dev/null || true
    mv -f "$temp" "$ACCOUNT_DB"
}

accounts_ready() {
    [ -s "$ACCOUNT_DB" ]
}

pki_ready() {
	[ -s "$PKI_DIR/ca.crt" ] && \
	[ -s "$PKI_DIR/issued/server.crt" ] && \
	[ -s "$PKI_DIR/private/server.key" ] && \
	[ -s "$PKI_DIR/crl.pem" ]
}

valid_client_certificate() {
	valid_client_name "$1" || return 1
	[ -s "$PKI_DIR/issued/$1.crt" ] || return 1
	[ -s "$PKI_DIR/private/$1.key" ] || return 1
	awk -F '\t' -v name="$1" '
		$1 == "V" && $6 ~ ("/CN=" name "$") { found = 1 }
		END { exit found ? 0 : 1 }
	' "$PKI_DIR/index.txt"
}

find_client_section() {
    local wanted="$1" section name
    CLIENT_SECTION=''
    for section in $(uci -q show openvpn_server 2>/dev/null |
        sed -n 's/^openvpn_server\.\([^.=]*\)=client$/\1/p'); do
        name="$(uci -q get "openvpn_server.$section.name" || true)"
        if [ "$name" = "$wanted" ]; then
            CLIENT_SECTION="$section"
            return 0
        fi
    done
    return 1
}

client_enabled() {
    local name="$1" state
    if ! find_client_section "$name"; then
        printf '1\n'
        return 0
    fi
    state="$(uci -q get "openvpn_server.$CLIENT_SECTION.enabled" || printf '1')"
    [ "$state" = '0' ] && printf '0\n' || printf '1\n'
}

ensure_client_record() {
    local name="$1"
    valid_client_name "$name" || return 1
    if ! find_client_section "$name"; then
        CLIENT_SECTION="$(uci -q add openvpn_server client)"
        uci -q set "openvpn_server.$CLIENT_SECTION.name=$name"
        uci -q set "openvpn_server.$CLIENT_SECTION.enabled=1"
    else
        uci -q get "openvpn_server.$CLIENT_SECTION.enabled" >/dev/null 2>&1 ||
            uci -q set "openvpn_server.$CLIENT_SECTION.enabled=1"
    fi
    uci -q commit openvpn_server
}

set_client_state() {
    local name="$CLIENT_NAME" state="$1"
    valid_client_name "$name" || fail '客户端用户名格式无效。'
    case "$state" in
        0|1) ;;
        *) fail '客户端状态无效。' ;;
    esac
    valid_client_certificate "$name" || fail '客户端证书不存在或已经吊销。'
    ensure_client_record "$name"
    uci -q set "openvpn_server.$CLIENT_SECTION.enabled=$state"
    uci -q commit openvpn_server
    /etc/init.d/openvpn reload >/dev/null 2>&1 || true
    [ "$state" = '1' ] && printf '客户端用户 %s 已启用。\n' "$name" ||
        printf '客户端用户 %s 已停用。\n' "$name"
}

delete_client() {
    local name="$CLIENT_NAME"
    valid_client_name "$name" || fail '客户端用户名格式无效。'
    [ "$name" != 'server' ] || fail '不能删除服务器证书。'
    valid_client_certificate "$name" || fail '客户端证书不存在或已经吊销。'
    easyrsa revoke "$name"
    easyrsa gen-crl
    chmod 0644 "$PKI_DIR/crl.pem"
    if find_client_section "$name"; then
        uci -q delete "openvpn_server.$CLIENT_SECTION"
        uci -q commit openvpn_server
    fi
    /etc/init.d/openvpn reload >/dev/null 2>&1 || true
    printf '客户端用户 %s 已删除，证书已吊销且不可恢复。\n' "$name"
}
reload_services() {
	/etc/init.d/network reload >/dev/null 2>&1 || true
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
	/etc/init.d/openvpn restart >/dev/null 2>&1 || true
}

render_server_config() {
    local proto="$1" port="$2" tunnel_type="$3" tunnel_device="$4"
    local vpn_network="$5" vpn_netmask="$6" max_clients="$7"
    local lan_network="$8" lan_netmask="$9" client_dns="${10}"
    local data_cipher="${11}" lzo="${12}" auth_mode="${13}" client_isolation="${14}" redirect_gateway="${15}" extra_config="${16}"
    local route route_network prefix route_netmask config_tmp

    config_tmp="$OPENVPN_CONFIG.tmp.$$"
    {
        printf 'proto %s\n' "$proto"
        printf 'port %s\n' "$port"
        printf 'dev %s\n' "$tunnel_device"
        printf 'dev-type %s\n' "$tunnel_type"
        printf 'topology subnet\n'
        printf 'server %s %s\n' "$vpn_network" "$vpn_netmask"
        printf 'max-clients %s\n' "$max_clients"
        printf 'ca %s\n' "$PKI_DIR/ca.crt"
        printf 'cert %s\n' "$PKI_DIR/issued/server.crt"
        printf 'key %s\n' "$PKI_DIR/private/server.key"
        printf 'dh none\n'
        printf 'crl-verify %s\n' "$PKI_DIR/crl.pem"
        printf 'tls-version-min 1.2\n'
        printf 'auth SHA256\n'
        printf 'keepalive 10 120\n'
        printf 'persist-key\n'
        printf 'persist-tun\n'
        [ "$client_isolation" = '0' ] && printf 'client-to-client\n'
        [ "$redirect_gateway" = '1' ] && printf 'push "redirect-gateway def1 bypass-dhcp"\n'
        printf 'user nobody\n'
        printf 'group nogroup\n'
        printf 'status /var/run/openvpn-server.status\n'
        printf 'verb 3\n'
        printf 'client-connect %s\n' "$CLIENT_CHECK_SCRIPT"
        printf 'script-security 2\n'
        [ -z "$data_cipher" ] || {
            printf 'data-ciphers %s\n' "$data_cipher"
            printf 'data-ciphers-fallback %s\n' "$data_cipher"
        }
        [ "$lzo" = '1' ] && printf 'comp-lzo yes\n'
        case "$auth_mode" in
            account|both)
                printf 'auth-user-pass-verify %s via-file\n' "$AUTH_SCRIPT"
                printf 'script-security 2\n'
                printf 'username-as-common-name\n'
                ;;
        esac
        [ "$auth_mode" = 'account' ] && printf 'verify-client-cert none\n'
        printf 'push "route %s %s"\n' "$lan_network" "$lan_netmask"
        printf 'push "dhcp-option DNS %s"\n' "$client_dns"
        while IFS= read -r route || [ -n "$route" ]; do
            [ -z "$route" ] && continue
            route_network="${route%%/*}"
            prefix="${route#*/}"
            route_netmask="$(prefix_to_netmask "$prefix")"
            printf 'push "route %s %s"\n' "$route_network" "$route_netmask"
        done <<EOF_ROUTES
$(list_configured_routes)
EOF_ROUTES
        if [ -n "$extra_config" ]; then
            printf '\n# 用户附加配置\n%s\n' "$extra_config"
        fi
    } > "$config_tmp"
    chmod 0600 "$config_tmp"
    mv -f "$config_tmp" "$OPENVPN_CONFIG"
}

apply_configuration() {
    local enabled proto port remote_host bind_interface vpn_network vpn_netmask
    local lan_network lan_netmask client_dns max_clients openvpn_enabled data_cipher
    local auth_mode tunnel_type tunnel_device lzo client_isolation redirect_gateway extra_config route

    enabled="$(uci -q get openvpn_server.main.enabled || printf '0')"
    proto="$(uci -q get openvpn_server.main.proto || printf 'udp')"
    port="$(uci -q get openvpn_server.main.port || printf '1194')"
    remote_host="$(uci -q get openvpn_server.main.remote_host || true)"
    bind_interface="$(uci -q get openvpn_server.main.bind_interface || printf 'wan')"
    vpn_network="$(uci -q get openvpn_server.main.vpn_network || printf '10.8.0.0')"
    vpn_netmask="$(uci -q get openvpn_server.main.vpn_netmask || printf '255.255.255.0')"
    lan_network="$(uci -q get openvpn_server.main.lan_network || printf '192.168.50.0')"
    lan_netmask="$(uci -q get openvpn_server.main.lan_netmask || printf '255.255.255.0')"
    client_dns="$(uci -q get openvpn_server.main.client_dns || printf '192.168.50.1')"
    max_clients="$(uci -q get openvpn_server.main.max_clients || printf '10')"
    auth_mode="$(uci -q get openvpn_server.main.auth_mode || printf 'cert')"
    tunnel_type="$(uci -q get openvpn_server.main.tunnel_type || printf 'tun')"
    lzo="$(uci -q get openvpn_server.main.lzo || printf '0')"
    client_isolation="$(uci -q get openvpn_server.main.client_isolation || printf '0')"
    redirect_gateway="$(uci -q get openvpn_server.main.redirect_gateway || printf '0')"
    extra_config="$(uci -q get openvpn_server.main.extra_config || true)"
    data_cipher=''
    if uci -q get openvpn_server.main.data_cipher >/dev/null 2>&1; then
        data_cipher="$(configured_data_cipher)"
    fi

    case "$enabled" in 0|1) ;; *) fail '启用状态无效。' ;; esac
    case "$proto" in udp|tcp-server) ;; *) fail '协议只能是 UDP 或 TCP。' ;; esac
    valid_auth_mode "$auth_mode" || fail '认证方式无效。'
    valid_tunnel_type "$tunnel_type" || fail '隧道类型只能是 TUN 或 TAP。'
    valid_boolean "$lzo" || fail 'LZO 开关值无效。'
    valid_boolean "$client_isolation" || fail '客户端通信隔离开关值无效。'
    valid_boolean "$redirect_gateway" || fail '客户端所有流量走远程网关开关值无效。'
    valid_uint "$port" && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || fail '端口必须在 1 到 65535 之间。'
    valid_remote_interface "$bind_interface" || fail '线路配置无效。'
    [ -z "$remote_host" ] || valid_remote_host "$remote_host" || fail '自定义 DDNS 地址格式无效。'
    valid_ipv4 "$vpn_network" || fail 'VPN 网络地址格式无效。'
    valid_ipv4 "$vpn_netmask" || fail 'VPN 子网掩码格式无效。'
    valid_ipv4 "$lan_network" || fail 'LAN 网络地址格式无效。'
    valid_ipv4 "$lan_netmask" || fail 'LAN 子网掩码格式无效。'
    valid_ipv4 "$client_dns" || fail '客户端 DNS 地址格式无效。'
    valid_uint "$max_clients" && [ "$max_clients" -ge 1 ] && [ "$max_clients" -le 1024 ] || fail '最大客户端数量必须在 1 到 1024 之间。'
    validate_extra_config "$extra_config" >/dev/null || fail '附加配置包含危险指令或不支持的内联配置块。'
    while IFS= read -r route || [ -n "$route" ]; do
        [ -z "$route" ] || valid_cidr "$route" || fail "推送路由格式无效：$route"
    done <<EOF_ROUTES
$(list_configured_routes)
EOF_ROUTES

    openvpn_enabled="$enabled"
    if [ "$enabled" = '1' ] && ! pki_ready; then
        openvpn_enabled='0'
        printf '提示：尚未初始化证书，OpenVPN服务器保持停用。\n' >&2
    fi

    mkdir -p "$OPENVPN_DIR" /etc/openvpn
    chmod 0700 "$OPENVPN_DIR"
    sync_accounts
    if [ "$auth_mode" != 'cert' ] && ! accounts_ready; then
        fail '账号认证模式至少需要一个已配置账号。'
    fi

    tunnel_device="${tunnel_type}0"
    uci -q batch <<EOF
set openvpn.$OPENVPN_SECTION='openvpn'
set openvpn.$OPENVPN_SECTION.enabled='$openvpn_enabled'
set openvpn.$OPENVPN_SECTION.config='$OPENVPN_CONFIG'
set openvpn.$OPENVPN_SECTION.proto='$proto'
set openvpn.$OPENVPN_SECTION.port='$port'
set openvpn.$OPENVPN_SECTION.server='$vpn_network $vpn_netmask'
set openvpn.$OPENVPN_SECTION.dev='$tunnel_device'
set openvpn.$OPENVPN_SECTION.dev_type='$tunnel_type'
set openvpn.$OPENVPN_SECTION.max_clients='$max_clients'
set firewall.openvpn_server.proto='${proto%-server}'
set firewall.openvpn_server.dest_port='$port'
set network.vpn0.device='$tunnel_device'
EOF

uci -q delete "openvpn.$OPENVPN_SECTION.tls_crypt" >/dev/null 2>&1 || true
uci -q delete "openvpn.$OPENVPN_SECTION.tls_auth" >/dev/null 2>&1 || true
for option in auth_user_pass_verify script_security verify_client_cert client_cert_not_required username_as_common_name comp_lzo; do
    uci -q delete "openvpn.$OPENVPN_SECTION.$option" >/dev/null 2>&1 || true
done

set_openvpn_default topology 'subnet'
set_openvpn_default ca "$PKI_DIR/ca.crt"
set_openvpn_default cert "$PKI_DIR/issued/server.crt"
set_openvpn_default key "$PKI_DIR/private/server.key"
set_openvpn_default dh 'none'
set_openvpn_default crl_verify "$PKI_DIR/crl.pem"
set_openvpn_default tls_version_min '1.2'
set_openvpn_default auth 'SHA256'
set_openvpn_default keepalive '10 120'
set_openvpn_default persist_key '1'
set_openvpn_default persist_tun '1'
if [ "$client_isolation" = '0' ]; then
    uci -q set "openvpn.$OPENVPN_SECTION.client_to_client=1"
else
    uci -q delete "openvpn.$OPENVPN_SECTION.client_to_client"
fi
set_openvpn_default user 'nobody'
set_openvpn_default group 'nogroup'
set_openvpn_default status '/var/run/openvpn-server.status'
set_openvpn_default verb '3'
[ "$lzo" = '1' ] && uci -q set "openvpn.$OPENVPN_SECTION.comp_lzo=yes"
[ "$auth_mode" = 'account' ] && uci -q set "openvpn.$OPENVPN_SECTION.verify_client_cert=none"
[ "$auth_mode" != 'cert' ] && uci -q set "openvpn.$OPENVPN_SECTION.auth_user_pass_verify=$AUTH_SCRIPT via-file"
[ "$auth_mode" != 'cert' ] && uci -q set "openvpn.$OPENVPN_SECTION.script_security=2"
[ "$auth_mode" != 'cert' ] && uci -q set "openvpn.$OPENVPN_SECTION.username_as_common_name=1"

[ -z "$data_cipher" ] || {
    uci -q set "openvpn.$OPENVPN_SECTION.data_ciphers=$data_cipher"
    uci -q set "openvpn.$OPENVPN_SECTION.data_ciphers_fallback=$data_cipher"
}

replace_managed_push managed_push_route "route $lan_network $lan_netmask"
replace_managed_push managed_push_dns "dhcp-option DNS $client_dns"
if [ "$redirect_gateway" = '1' ]; then
    replace_managed_push managed_push_gateway 'redirect-gateway def1 bypass-dhcp'
else
    remove_managed_push managed_push_gateway
fi

render_server_config "$proto" "$port" "$tunnel_type" "$tunnel_device" "$vpn_network" "$vpn_netmask" "$max_clients" \
    "$lan_network" "$lan_netmask" "$client_dns" "$data_cipher" "$lzo" "$auth_mode" "$client_isolation" "$redirect_gateway" "$extra_config"

uci -q commit openvpn
uci -q commit openvpn_server
uci -q commit firewall
uci -q commit network
reload_services

if [ "$enabled" = '1' ] && [ "$openvpn_enabled" = '0' ]; then
    return 1
fi

printf 'OpenVPN服务器配置已应用。\n'
}


save_account() {
    local stage="$CLIENT_NAME" username password section salt hash enabled
    case "$stage" in
        /tmp/openvpn-account.*) ;;
        *) fail '账号临时文件路径无效。' ;;
    esac
    [ -s "$stage" ] || fail '账号临时文件为空。'
    username="$(sed -n '1p' "$stage")"
    password="$(sed -n '2p' "$stage")"
    valid_account_username "$username" || fail '用户名只能包含字母、数字、下划线、点和连字符，且不能超过32个字符。'
    [ "${#password}" -le 256 ] || fail '密码长度不能超过256个字符。'
    find_account_section "$username" || ACCOUNT_SECTION=''
    section="$ACCOUNT_SECTION"
    if [ -z "$section" ]; then
        section="$(uci -q add openvpn_server account)"
    fi
    uci -q set "openvpn_server.$section.username=$username"
    if [ -n "$password" ]; then
        salt="$(random_salt)"
        hash="$(password_hash "$salt" "$password")"
        uci -q set "openvpn_server.$section.salt=$salt"
        uci -q set "openvpn_server.$section.password_hash=$hash"
    else
        [ -n "$(uci -q get "openvpn_server.$section.password_hash" || true)" ] || fail '新增账号必须填写密码。'
    fi
    uci -q set "openvpn_server.$section.enabled=1"
    uci -q commit openvpn_server
    sync_accounts
    enabled="$(uci -q get openvpn_server.main.enabled || printf '0')"
    [ "$enabled" = '1' ] && /etc/init.d/openvpn restart >/dev/null 2>&1 || true
    printf '账号 %s 已保存。\n' "$username"
}

delete_account() {
    local username="$CLIENT_NAME" enabled
    valid_account_username "$username" || fail '用户名格式无效。'
    find_account_section "$username" || fail '账号不存在。'
    uci -q delete "openvpn_server.$ACCOUNT_SECTION"
    uci -q commit openvpn_server
    sync_accounts
    enabled="$(uci -q get openvpn_server.main.enabled || printf '0')"
    [ "$enabled" = '1' ] && /etc/init.d/openvpn restart >/dev/null 2>&1 || true
    printf '账号 %s 已删除。\n' "$username"
}

initialize_pki() {
	local existing_file

	[ ! -s "$PKI_DIR/ca.crt" ] || fail 'PKI已经初始化，不会覆盖现有CA。'
	command -v easyrsa >/dev/null 2>&1 || fail '缺少 easyrsa 命令。'
	command -v openvpn >/dev/null 2>&1 || fail '缺少 openvpn 命令。'

	existing_file="$(find "$PKI_DIR" -type f -print -quit 2>/dev/null || true)"
	[ -z "$existing_file" ] || fail 'PKI目录存在未完成文件，请先人工检查，系统不会自动删除。'

	mkdir -p "$EASYRSA_DIR" "$OPENVPN_DIR"
	chmod 0700 "$OPENVPN_DIR"

	easyrsa init-pki
	EASYRSA_REQ_CN='ImmortalWrt OpenVPN CA' easyrsa build-ca nopass
	easyrsa build-server-full server nopass
	easyrsa gen-crl
	create_client 'default'

	chmod 0700 "$PKI_DIR" "$PKI_DIR/private" "$OPENVPN_DIR"
	chmod 0600 "$PKI_DIR/private/ca.key" "$PKI_DIR/private/server.key"
	chmod 0644 "$PKI_DIR/crl.pem"
	apply_configuration
	printf 'OpenVPN CA和服务器证书已生成。\n'
}

create_client() {
	valid_client_name "$CLIENT_NAME" || fail '客户端名称只能包含字母、数字、下划线和连字符，且不能超过32个字符。'
	pki_ready || fail '请先初始化OpenVPN PKI。'
	[ ! -e "$PKI_DIR/issued/$CLIENT_NAME.crt" ] || fail '客户端证书已经存在。'

	easyrsa build-client-full "$CLIENT_NAME" nopass
	chmod 0600 "$PKI_DIR/private/$CLIENT_NAME.key"
	ensure_client_record "$CLIENT_NAME"
	printf '客户端证书 %s 已生成。\n' "$CLIENT_NAME"
}

revoke_client() {
	valid_client_name "$CLIENT_NAME" || fail '客户端名称无效。'
	[ "$CLIENT_NAME" != 'server' ] || fail '不能通过客户端页面吊销服务器证书。'
	valid_client_certificate "$CLIENT_NAME" || fail '客户端证书不存在或已经吊销。'

	easyrsa revoke "$CLIENT_NAME"
	easyrsa gen-crl
	chmod 0644 "$PKI_DIR/crl.pem"
	/etc/init.d/openvpn reload >/dev/null 2>&1 || true
	printf '客户端证书 %s 已吊销。\n' "$CLIENT_NAME"
}

list_clients() {
    local name state
    [ -s "$PKI_DIR/index.txt" ] || exit 0
    while IFS= read -r name || [ -n "$name" ]; do
        [ -n "$name" ] || continue
        state="$(client_enabled "$name")"
        printf '%s|%s\n' "$name" "$state"
    done <<EOF_CLIENTS
$(awk -F '\t' '
    $1 == "V" && $6 !~ /\/CN=server$/ {
        name = $6
        sub(/^.*\/CN=/, "", name)
        print name
    }
' "$PKI_DIR/index.txt")
EOF_CLIENTS
}

export_client() {
    local remote_host bind_interface port proto auth_mode tunnel_type lzo data_cipher

    auth_mode="$(uci -q get openvpn_server.main.auth_mode || printf 'cert')"
    tunnel_type="$(uci -q get openvpn_server.main.tunnel_type || printf 'tun')"
    lzo="$(uci -q get openvpn_server.main.lzo || printf '0')"
    data_cipher="$(uci -q get openvpn_server.main.data_cipher || true)"
    valid_auth_mode "$auth_mode" || fail '认证方式配置无效。'
    valid_tunnel_type "$tunnel_type" || fail '隧道类型配置无效。'
    if [ "$auth_mode" = 'cert' ] || [ "$auth_mode" = 'both' ]; then
        valid_client_certificate "$CLIENT_NAME" || fail '客户端证书不存在或已经吊销。'
    else
        valid_client_name "$CLIENT_NAME" || fail '客户端名称无效。'
    fi
    remote_host="$(uci -q get openvpn_server.main.remote_host || true)"
    bind_interface="$(uci -q get openvpn_server.main.bind_interface || printf 'wan')"
    port="$(uci -q get openvpn_server.main.port || printf '1194')"
    proto="$(uci -q get openvpn_server.main.proto || printf 'udp')"
    valid_remote_interface "$bind_interface" || fail '线路配置无效。'
    if [ -z "$remote_host" ]; then
        remote_host="$(interface_address "$bind_interface" || true)"
        [ -n "$remote_host" ] || fail "无法获取线路$bind_interface的IP地址。"
    fi
    valid_remote_host "$remote_host" || fail '自定义 DDNS 地址格式无效。'
    case "$proto" in
        tcp-server) proto='tcp-client' ;;
        udp) ;;
        *) fail 'OpenVPN协议配置无效。' ;;
    esac

    cat <<EOF
client
dev $tunnel_type
proto $proto
remote $remote_host $port
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
auth-nocache
verb 3
EOF
    [ -z "$data_cipher" ] || printf 'data-ciphers %s\ndata-ciphers-fallback %s\n' "$data_cipher" "$data_cipher"
    [ "$lzo" = '1' ] && printf 'comp-lzo yes\n'
    case "$auth_mode" in
        account|both) printf 'auth-user-pass\n' ;;
    esac
    printf '%s\n' '<ca>'
    sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' "$PKI_DIR/ca.crt"
    printf '%s\n' '</ca>'
    if [ "$auth_mode" = 'cert' ] || [ "$auth_mode" = 'both' ]; then
        printf '%s\n' '<cert>'
        sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' "$PKI_DIR/issued/$CLIENT_NAME.crt"
        printf '%s\n' '</cert>'
        printf '%s\n' '<key>'
        sed -n '/-----BEGIN PRIVATE KEY-----/,/-----END PRIVATE KEY-----/p' "$PKI_DIR/private/$CLIENT_NAME.key"
        printf '%s\n' '</key>'
    fi
}

case "$ACTION" in
	apply) apply_configuration ;;
	save-account) save_account ;;
	delete-account) delete_account ;;
	init-pki) initialize_pki ;;
	create-client) create_client ;;
	revoke-client) revoke_client ;;
	list-clients) list_clients ;;
	enable-client) set_client_state 1 ;;
	disable-client) set_client_state 0 ;;
	delete-client) delete_client ;;
	export-client) export_client ;;
	list-ciphers) list_data_ciphers ;;
	recommended-cipher) recommended_data_cipher ;;
	*) fail '用法：openvpn-server-manager {apply|save-account|delete-account|init-pki|create-client|revoke-client|list-clients|enable-client|disable-client|delete-client|export-client|list-ciphers|recommended-cipher} [参数]' ;;
esac
